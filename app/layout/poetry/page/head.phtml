<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Просто поезія</title>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const themeButtons = document.querySelectorAll('.theme-vintage-btn');
            const body = document.body;

            const savedTheme = localStorage.getItem('theme') || 'system';
            applyTheme(savedTheme);

            themeButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const theme = btn.dataset.theme;
                    applyTheme(theme);
                    localStorage.setItem('theme', theme);
                });
            });

            function applyTheme(theme) {
                themeButtons.forEach(btn => btn.classList.remove('active'));
                const themeElement = document.querySelector(`[data-theme="${theme}"]`);
                if (themeElement) {
                    themeElement.classList.add('active');
                }
                
                body.classList.remove('light', 'dark');
                if (theme !== 'system') {
                    body.classList.add(theme);
                }
            }

            // Burger menu toggle
            const burgerMenu = document.querySelector('.burger-menu');
            const mobileNavWrapper = document.querySelector('.mobile-nav-wrapper');

            if (burgerMenu && mobileNavWrapper) {
                burgerMenu.addEventListener('click', () => {
                    burgerMenu.classList.toggle('active');
                    mobileNavWrapper.classList.toggle('active');
                });

                // Close menu when clicking outside
                document.addEventListener('click', (e) => {
                    if (!e.target.closest('.header-wrapper')) {
                        burgerMenu.classList.remove('active');
                        mobileNavWrapper.classList.remove('active');
                    }
                });

                // Close menu when clicking on a link
                const navLinks = document.querySelectorAll('.nav-vintage a');
                navLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        burgerMenu.classList.remove('active');
                        mobileNavWrapper.classList.remove('active');
                    });
                });
            }

            // Logo typing effect
            const logoText = document.getElementById('logo-text');
            if (logoText) {
                const fullText = logoText.dataset.text;
                const TYPING_PAUSE = 2000; // Pause after typing completes (ms)
                const BACKSPACE_PAUSE = 1000; // Pause after backspace completes (ms)
                let currentCharPosition = 0;
                let isTyping = true;
                let timeoutId = null;

                // Check if user prefers reduced motion
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                
                if (prefersReducedMotion) {
                    // Keep static text for users who prefer reduced motion
                    return;
                }

                // Mark element as decorative for screen readers (aria-label already provides full text)
                logoText.setAttribute('aria-live', 'off');

                function getRandomDelay(min, max) {
                    return Math.floor(Math.random() * (max - min + 1)) + min;
                }

                function typeWriter() {
                    if (isTyping) {
                        if (currentCharPosition <= fullText.length) {
                            logoText.textContent = fullText.substring(0, currentCharPosition);
                            currentCharPosition++;
                            timeoutId = setTimeout(typeWriter, getRandomDelay(50, 200));
                        } else {
                            // Pause before starting backspace
                            timeoutId = setTimeout(() => {
                                isTyping = false;
                                backspace();
                            }, TYPING_PAUSE);
                        }
                    }
                }

                function backspace() {
                    if (!isTyping) {
                        if (currentCharPosition > 0) {
                            currentCharPosition--;
                            logoText.textContent = fullText.substring(0, currentCharPosition);
                            timeoutId = setTimeout(backspace, getRandomDelay(30, 100));
                        } else {
                            // Pause before starting typing again
                            timeoutId = setTimeout(() => {
                                isTyping = true;
                                typeWriter();
                            }, BACKSPACE_PAUSE);
                        }
                    }
                }

                // Cleanup on page unload
                window.addEventListener('beforeunload', () => {
                    if (timeoutId) {
                        clearTimeout(timeoutId);
                    }
                });

                // Start the animation
                typeWriter();
            }
        });
    </script>
    <?= $this->assets() ?>
</head>